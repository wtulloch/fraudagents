# =============================================================================
# Azure AI Foundry (MAF — Microsoft Agent Framework)
# =============================================================================
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.api.azureml.ms
AZURE_AI_FOUNDRY_PROJECT_CONNECTION_STRING=<region>.<subscription-id>.<resource-group>.<project-name>

# Model deployments in Foundry (Model Router)
MODEL_GPT4O_MINI=gpt-4o-mini
MODEL_GPT4O=gpt-4o
MODEL_O3_MINI=o3-mini
MODEL_EMBEDDING=text-embedding-3-large

# =============================================================================
# Azure OpenAI (via Foundry endpoint — Responses API v2)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# =============================================================================
# Azure AI Search
# =============================================================================
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-key>
AZURE_SEARCH_TRANSACTIONS_INDEX=transactions-index
AZURE_SEARCH_KYC_INDEX=kyc-index
AZURE_SEARCH_MEDIA_INDEX=media-index
AZURE_SEARCH_SANCTIONS_INDEX=sanctions-index

# =============================================================================
# Azure Cosmos DB (session management, audit trail, HITL queue)
# =============================================================================
AZURE_COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
AZURE_COSMOS_KEY=<your-cosmos-key>
AZURE_COSMOS_DATABASE=fraud-detection-db

# =============================================================================
# Azure Content Safety (Prompt Shields + Groundedness)
# =============================================================================
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-safety>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=<your-safety-key>

# =============================================================================
# Application Settings
# =============================================================================
APP_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Risk & Decision Gate Thresholds
# =============================================================================
RISK_SAR_THRESHOLD=0.75
RISK_ESCALATE_THRESHOLD=0.50
RISK_AUTO_CLOSE_THRESHOLD=0.25

# =============================================================================
# HITL (Human-In-The-Loop) Governance
# =============================================================================
HITL_PEP_THRESHOLD=0.70
HITL_HIGH_VALUE_AMOUNT=100000
HITL_SWIFT_REQUIRE_REVIEW=true

# =============================================================================
# Groundedness & Hallucination Prevention
# =============================================================================
GROUNDEDNESS_SCORE_THRESHOLD=3.5
GROUNDEDNESS_CORRECTION_ENABLED=true

# =============================================================================
# Synthetic Data Generation
# =============================================================================
SYNTHETIC_SEED=42
SYNTHETIC_DEFAULT_RECORDS=500
